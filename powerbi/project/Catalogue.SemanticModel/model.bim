            "lineageTag": "6dd8f9cb-70f8-4151-a30e-3a0a07f2f0a0",
            "sourceColumn": "MissingName",
            "summarizeBy": "none"
          },
          {
            "name": "HasObservedPrice",
            "dataType": "boolean",
            "lineageTag": "e1b7b037-dbc0-43d6-94c2-2f203b69f80b",
            "sourceColumn": "HasObservedPrice",
            "summarizeBy": "none"
          },
          {
            "name": "HasRecallCandidate",
            "dataType": "boolean",
            "lineageTag": "bdd958a4-c4fe-4bd6-a055-2019cba205fc",
            "sourceColumn": "HasRecallCandidate",
            "summarizeBy": "none"
          },
          {
            "name": "DescriptionReviewFlag",
            "dataType": "boolean",
            "lineageTag": "b04a16a9-058b-4d24-9d2c-1aaefc6801dd",
            "sourceColumn": "DescriptionReviewFlag",
            "summarizeBy": "none"
          },
          {
            "name": "CoverageGroup",
            "dataType": "string",
            "lineageTag": "c55d1a96-1ab3-4b57-94fc-49540e3f3be2",
            "sourceColumn": "CoverageGroup",
            "summarizeBy": "none"
          }
        ],
        "lineageTag": "63af15db-882e-428e-b0a4-0b0665b96850",
        "measures": [
          {
            "name": "Catalogue products",
            "expression": "CALCULATE(COUNTROWS(DimProduct), DimProduct[InProductCatalogue] = TRUE())",
            "formatString": "#,0",
            "lineageTag": "e12b0324-a97a-42ef-878f-c84929457f39"
          },
          {
            "name": "Products with prices",
            "expression": "CALCULATE([Catalogue products], DimProduct[HasObservedPrice] = TRUE())",
            "formatString": "#,0",
            "lineageTag": "f3131b66-0c3d-47fb-93b3-fe583387c311"
          },
          {
            "name": "Price coverage",
            "expression": "DIVIDE([Products with prices], [Catalogue products])",
            "formatString": "0.00%",
            "lineageTag": "6451ed2b-aec2-4199-af92-914081233b36"
          },
          {
            "name": "Products with recall candidates",
            "expression": "CALCULATE([Catalogue products], DimProduct[HasRecallCandidate] = TRUE())",
            "formatString": "#,0",
            "lineageTag": "82ee4d60-2821-4c22-b783-651b980f1cfd"
          },
          {
            "name": "Recall coverage",
            "expression": "DIVIDE([Products with recall candidates], [Catalogue products])",
            "formatString": "0.00%",
            "lineageTag": "debefa69-d4cf-49f4-9e56-76c0d4660940"
          },
          {
            "name": "Missing product names",
            "expression": "CALCULATE([Catalogue products], DimProduct[MissingName] = TRUE())",
            "formatString": "#,0",
            "lineageTag": "0d660028-68ff-4f44-95d8-39d73373a5d8"
          },
          {
            "name": "Missing name share",
            "expression": "DIVIDE([Missing product names], [Catalogue products])",
            "formatString": "0.00%",
            "lineageTag": "b865a9ff-baee-45a7-a7e5-5eae55bb5793"
          },
          {
            "name": "All three sources",
            "expression": "CALCULATE([Catalogue products], DimProduct[HasObservedPrice] = TRUE(), DimProduct[HasRecallCandidate] = TRUE())",
            "formatString": "#,0",
            "lineageTag": "ee9c8612-fc4e-4d26-bb94-615f76d09933"
          },
          {
            "name": "Price observations",
            "expression": "COUNTROWS(FactPrice)",
            "formatString": "#,0",
            "lineageTag": "d3a2d0d1-63f9-4cc2-a1d3-e223093c1704"
          },
          {
            "name": "Historical notices",
            "expression": "COUNTROWS(DimNotice)",
            "formatString": "#,0",
            "lineageTag": "3478aef7-c6c7-403d-9816-5c1e7f6ad1f5"
          },
          {
            "name": "Candidate links",
            "expression": "COUNTROWS(FactRecallLink)",
            "formatString": "#,0",
            "lineageTag": "cfd23d85-57e5-4560-9680-3d2f60142bdc"
          },
          {
            "name": "Linked notices",
            "expression": "DISTINCTCOUNT(FactRecallLink[NoticeId])",
            "formatString": "#,0",
            "lineageTag": "d9e6febc-166b-41c8-a34c-6593ae33f4eb"
          },
          {
            "name": "Candidate product codes",
            "expression": "DISTINCTCOUNT(FactRecallLink[ProductCode])",
            "formatString": "#,0",
            "lineageTag": "962837bc-f31a-40d7-aee3-b6d392b3960e"
          },
          {
            "name": "Description review links",
            "expression": "CALCULATE([Candidate links], FactRecallLink[DescriptionReviewFlag] = TRUE())",
            "formatString": "#,0",
            "lineageTag": "b2fc6649-6c44-4e69-a77b-323004e3154f"
          },
          {
            "name": "Observed stores",
            "expression": "CALCULATE(DISTINCTCOUNT(FactPrice[LocationId]), FactPrice[LocationId] <> -1)",
            "formatString": "#,0",
            "lineageTag": "5e9f07d1-e076-4615-8d67-75c0864285d4"
          },
          {
            "name": "Median comparable price",
            "expression": "IF(CALCULATE(HASONEVALUE(FactPrice[ProductCode]) && HASONEVALUE(FactPrice[Currency]) && HASONEVALUE(FactPrice[PriceUnit]), ALLSELECTED(DimPriceDate), ALLSELECTED(DimLocation)), MEDIAN(FactPrice[ObservedPrice]), BLANK())",
            "formatString": "0.00",
            "lineageTag": "9a933200-da2b-4322-8ec1-1f78c0534941"
          },
          {
            "name": "Price selection guidance",
            "expression": "IF(CALCULATE(HASONEVALUE(FactPrice[ProductCode]) && HASONEVALUE(FactPrice[Currency]) && HASONEVALUE(FactPrice[PriceUnit]), ALLSELECTED(DimPriceDate), ALLSELECTED(DimLocation)), \"Same code, currency and reported unit. Packaging changes remain unresolved.\", \"Select ONE product code, currency and price unit to view a median.\")",
            "lineageTag": "9123d628-91ad-4ba0-877b-544d43ebc3cc"
          }
        ],
        "partitions": [
